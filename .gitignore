*.pt
*.pth
*.bin
*.ckpt
*.gguf
*.onnx

# ---------------------------------------------------------------- pulled Kaggle outputs: keep reports, predictions and run metadata; drop weights, logs, dry runs
reports/**/adapter/
reports/**/hidden/
reports/*_smoke*/
reports/kaggle_*_dry/
reports/kaggle_train_dry/
reports/*.log
reports/kaggle_*/*.log

